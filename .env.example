# Postgres (Neon). Used by Drizzle, better-auth, and Mastra's own storage.
DATABASE_URL="postgresql://user:password@host/junkclaw?sslmode=require"

# better-auth
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional alongside magic link). NOT Facebook — see the build plan.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Model provider. Mastra routes across providers; nothing here is hardcoded in
# packages/agents beyond the default below.
ANTHROPIC_API_KEY=""
JUNKCLAW_MODEL="claude-opus-5"

# Where the extension sends listing facts.
JUNKCLAW_API_URL="http://localhost:3000"
