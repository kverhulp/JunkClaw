{
  "name": "junkclaw",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter @junkclaw/web dev",
    "dev:ext": "pnpm --filter @junkclaw/extension dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "guards": "./scripts/guards.sh",
    "verify": "./scripts/guards.sh && eslint . && pnpm -r typecheck && vitest run",
    "db:generate": "pnpm --filter @junkclaw/db generate",
    "db:migrate": "pnpm --filter @junkclaw/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.10"
  }
}
