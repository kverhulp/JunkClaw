{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "required": [
    "listedPriceRange",
    "make",
    "model",
    "location",
    "imageURLs",
    "listingService"
  ],
  "properties": {
    "make": {
      "type": "number",
      "description": "year of manufacture",
      "minimum": 1900,
      "maximum": 2026,
      "multipleOf": 1
    },
    "model": {
      "type": "object",
      "description": "brand / manufacturer name and model name",
      "properties": {
        "brand": {
          "type": "string",
          "description": "manufacturer"
        },
        "name": {
          "type": "string",
          "description": "name of the model without the brand / manufacturer name"
        }
      },
      "additionalProperties": false,
      "required": [
        "brand",
        "name"
      ]
    },
    "listedPriceRange": {
      "type": "object",
      "description": "the price range listed for this vehicle",
      "properties": {
        "min": {
          "type": "number",
          "description": "minimum listed price"
        },
        "max": {
          "type": "number",
          "description": "maximum listed price"
        },
        "currency": {
          "minLength": 3,
          "type": "string",
          "maxLength": 3,
          "description": "ISO 4217 currency code"
        }
      },
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "currency"
      ]
    },
    "location": {
      "type": "object",
      "description": "listing location",
      "additionalProperties": false,
      "properties": {
        "country": {
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[a-z]{3}$",
          "type": "string",
          "description": "ISO 3166-1 alpha-3 code of the country"
        },
        "subdivision": {
          "type": "string",
          "description": "principal subdvision of the location for the given country"
        },
        "municipality": {
          "type": "string",
          "description": "the name of the city, town or other municipality type"
        }
      }
    },
    "imageURLs": {
      "type": "array",
      "description": "urls to any images of the vehicle from the listing",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "listingService": {
      "type": "string",
      "description": "name of the listing service the vehicle listing is from"
    }
  }
}